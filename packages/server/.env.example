# ===== 服务 =====
NODE_ENV=development
PORT=3000
# 对外可访问的基础地址（反向代理/上线后填写，如 https://dist.shixian.xyz）
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180,http://localhost:5200,http://127.0.0.1:5200

# ===== 管理端 =====
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
# 首次启动时自动创建管理员；已存在则不会覆盖密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vakao_hub
# 开发期自动建表；生产必须设为 false 并改用迁移
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# ===== 存储 =====
# 安装包存放目录，相对 server 运行目录
STORAGE_DIR=storage
# 单文件上限，默认 2GB
UPLOAD_MAX_BYTES=2147483648
